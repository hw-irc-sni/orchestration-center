# Copy to .env and fill in as needed. .env is gitignored — never commit real secrets.
#
# This file is read in two independent ways, neither of which ever overwrites it:
#  1. Docker Compose reads it natively for ${VAR} substitution in
#     docker-compose.yml / docker-compose-dev.yml, which forwards the values into
#     the container's environment. docker-entrypoint.sh then writes the ORCH_*/DB_*
#     values into etc/conf/server.conf and etc/conf/db_config.json.
#  2. The backend reads the LLM_* block below directly (see
#     common/llm/config/env_overrides.py), overriding common/config/llm_config.json.
#     The workflow-engine SDK reads the A2AT_* block directly for negotiation. There
#     is no generator and no etc/conf/a2at.env — LLM_CHAT_* and A2AT_* are two
#     independent configs; changing one does not affect the other.

# ============================================================
# Docker Compose — etc/conf/server.conf overrides (optional; defaults shown)
# ============================================================
# ORCH_IP=0.0.0.0
# ORCH_PORT=5001
# ORCH_ENABLE_HTTPS=false
# ORCH_FORWARDED_ALLOW_IPS=*
# PERSISTENCE_MODE=file
# AGENT_REGISTRY_URL=https://openan-registry-center:5000

# ============================================================
# Docker Compose — optional PostgreSQL persistence (docker-compose.yml).
# Only read when PERSISTENCE_MODE=postgresql.
# ============================================================
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=orchestration_center
# DB_USERNAME=
# DB_PASSWORD=

# ============================================================
# LLM configuration — overrides common/config/llm_config.json
#
# Naming: LLM_<CAPABILITY>_<FIELD>, where CAPABILITY is chat / embed / rerank and
# FIELD is any scalar config key: MODEL, URL, API_KEY, ENABLE_THINKING,
# VERIFY_SSL, DESCRIPTION. Precedence is environment > this file > llm_config.json.
# Structured fields (auth, headers, body, response) stay in the JSON — they are
# request templates.
#
# Only the LLM_CHAT_* variables below are wired through docker-compose.yml. In a
# container the others are JSON-only, unless you bind-mount this file into it.
#
# Required before anything can run: MODEL, URL, API_KEY.
# ============================================================
# LLM_CHAT_MODEL=
# LLM_CHAT_API_KEY=
# LLM_CHAT_URL=

# --- Example: OpenAI ---
# LLM_CHAT_MODEL=gpt-4o
# LLM_CHAT_URL=https://api.openai.com/v1/chat/completions

# --- Example: DeepSeek ---
# LLM_CHAT_MODEL=deepseek-chat
# LLM_CHAT_URL=https://api.deepseek.com/v1/chat/completions

# --- Example: Qwen / DashScope ---
# LLM_CHAT_MODEL=qwen-plus
# LLM_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- Example: self-hosted gateway ---
# LLM_CHAT_MODEL=Qwen3_32B
# LLM_CHAT_URL=https://gateway.internal/llm/api/chat/completions
# LLM_CHAT_VERIFY_SSL=false

# ============================================================
# A2A-T SDK Configuration — read directly by the workflow-engine SDK for
# negotiation. Independent of LLM_CHAT_* above; nothing auto-derives one from
# the other. Required for PSOP generation/execution and negotiation to
# actually succeed; leave A2AT_LLM_API_KEY blank and calls will fail auth.
# ============================================================

# Prompt runtime
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_PROMPT_COMPLIANCE_GUARDRAIL_PROVIDER=noop

# LLM runtime
A2AT_LLM_PROVIDER=deepseek
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100

# Negotiation
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
