# Copy to .env and fill in as needed. .env is gitignored — never commit real secrets.
#
# This file serves two independent purposes:
#  1. Docker Compose reads it natively for ${VAR} substitution in
#     docker-compose.yml / docker-compose-dev.yml. Values passed through to
#     the container are then written by docker-entrypoint.sh into
#     etc/conf/server.conf, etc/conf/db_config.json, and
#     common/config/llm_config.json.
#  2. The A2AT_* block below is consumed directly by the a2a-t-sdk. It is
#     auto-(re)generated by common/a2at_config.py from
#     common/config/llm_config.json whenever `python -m
#     samples.start_agents_server` runs against a missing .env, or one with
#     an empty A2AT_LLM_MODEL — at that point the whole file is overwritten,
#     including any Compose-only variables you set below. To change the LLM
#     model/key for good, edit common/config/llm_config.json rather than
#     this file.

# ============================================================
# Docker Compose — etc/conf/server.conf overrides (optional; defaults shown)
# ============================================================
# ORCH_IP=0.0.0.0
# ORCH_PORT=5001
# ORCH_ENABLE_HTTPS=false
# ORCH_FORWARDED_ALLOW_IPS=*
# PERSISTENCE_MODE=file
# AGENT_REGISTRY_URL=https://openan-registry-center:5000

# ============================================================
# Docker Compose — optional PostgreSQL persistence (docker-compose.yml).
# Only read when PERSISTENCE_MODE=postgresql.
# ============================================================
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=orchestration_center
# DB_USERNAME=
# DB_PASSWORD=

# ============================================================
# Docker Compose — chat LLM overrides (written into
# common/config/llm_config.json[chat] by docker-entrypoint.sh)
# ============================================================
# LLM_CHAT_MODEL=deepseek-chat
# LLM_CHAT_API_KEY=
# LLM_CHAT_URL=https://api.deepseek.com/v1/chat/completions

# ============================================================
# A2A-T SDK Configuration (see note above — usually auto-generated)
# ============================================================

# Prompt runtime
A2AT_LANGUAGE=zh-CN
A2AT_PROMPT_SOURCE_TYPE=local_file
A2AT_PROMPT_RESOURCE_LOCAL_ROOT_DIR=

# Prompt compliance
A2AT_PROMPT_COMPLIANCE_ENABLED=false
A2AT_PROMPT_COMPLIANCE_GUARDRAIL_PROVIDER=noop

# LLM runtime — required for PSOP generation/execution and negotiation to
# actually succeed; leave A2AT_LLM_API_KEY blank and calls will fail auth.
A2AT_LLM_PROVIDER=deepseek
A2AT_LLM_MODEL=deepseek-chat
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=https://api.deepseek.com
A2AT_LLM_MAX_TOKENS=2000
A2AT_LLM_TEMPERATURE=0
A2AT_LLM_TIMEOUT_SECONDS=60
A2AT_LLM_HISTORY_WINDOW=10
A2AT_LLM_SESSION_MAX_TOTAL=300
A2AT_LLM_SESSION_MAX_PER_PROVIDER=100

# Negotiation
A2AT_NEGOTIATION_STATE_STORE_TYPE=in_memory
